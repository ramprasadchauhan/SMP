# ---------------------------------------------------------------------------
# SMP API configuration. Copy to `.env` and fill in real values.
# Never commit `.env`. All values below are placeholders.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
# Port for the API (the Vite dev server proxies /api to this port).
PORT=8000

# MongoDB connection string (required).
MONGO=mongodb://localhost:27017/smp

# Secret used to sign session tokens (required). Use a long random value,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
JWT_SECRET=replace-with-a-long-random-secret
# Session lifetime in hours (default 24).
SESSION_TTL_HOURS=24

# Cloudinary credentials for product photo uploads (optional; uploads return
# 503 "not configured" when missing).
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty when the client is served by this server (the default setup).
CORS_ORIGINS=
# Number of reverse proxies in front of the app (set 1 on Render/Heroku/Nginx)
# so rate limiting sees real client IPs.
TRUST_PROXY=0
# Build MongoDB indexes automatically on startup. Keep false for shared or
# production databases and use `npm run db:migrate:apply` instead.
MONGO_AUTO_INDEX=false
# Set to false only for automated tests.
RATE_LIMIT_ENABLED=true
# debug | info | warn | error | silent (default: debug in dev, info in prod)
LOG_LEVEL=
