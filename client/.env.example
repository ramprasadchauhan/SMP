# Client build-time settings. Everything prefixed VITE_ is embedded in the
# public JavaScript bundle: never put secrets here.

# API base path or URL. Default "/api/v1" (same origin as the client).
VITE_API_BASE_URL=/api/v1
# Where the Vite dev server proxies /api requests (development only).
VITE_API_PROXY_TARGET=http://localhost:8000
